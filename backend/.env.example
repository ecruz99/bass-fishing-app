# Copy to .env (never committed) and adjust if needed.
# Matches the local database from docker-compose.yml.
DATABASE_URL=postgresql+psycopg://bass:bass@localhost:5433/bass_fishing

# At least 32 characters. Production uses its own.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=local-dev-only-not-a-real-secret-change-me
